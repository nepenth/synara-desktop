{
  "schemaVersion": 1,
  "outboundTextPayloadMaxBytes": 65536,
  "presentationFormattedBodyMaxBytes": 262144,
  "coverage": {
    "formatted-reply-fallback": [
      "adversarial-reply-fallback",
      "golden-formatted-reply-current-content"
    ],
    "mentions": [
      "golden-mentions-and-links",
      "adversarial-mention-and-duplicate-href"
    ],
    "spoilers": [
      "golden-spoiler-table",
      "golden-spoiler-table-caption",
      "adversarial-nested-spoiler"
    ],
    "links": [
      "golden-mentions-and-links",
      "adversarial-nonallowlisted-links",
      "adversarial-mention-and-duplicate-href"
    ],
    "lists": ["golden-rich-structure", "golden-nested-lists"],
    "inline-code": [
      "golden-rich-structure",
      "golden-formatted-reply-current-content"
    ],
    "preformatted-code": ["golden-hermes-approval", "golden-code-whitespace"],
    "tables": [
      "golden-spoiler-table",
      "golden-spoiler-table-caption",
      "golden-table-with-inline-code"
    ],
    "plaintext-fallback": [
      "adversarial-content-only-fallback",
      "adversarial-oversize-presentation",
      "adversarial-oversize-unicode"
    ],
    "malformed-html": [
      "adversarial-legacy-and-malformed",
      "adversarial-nested-spoiler",
      "adversarial-unterminated-comment"
    ],
    "executable-content": [
      "adversarial-executable-content",
      "adversarial-nested-spoiler"
    ],
    "remote-resource-blocking": [
      "adversarial-executable-content",
      "adversarial-mxc-inline-image"
    ],
    "presentation-size-boundary": [
      "golden-presentation-limit",
      "adversarial-oversize-presentation",
      "adversarial-oversize-unicode"
    ]
  },
  "cases": [
    {
      "id": "golden-rich-structure",
      "class": "golden",
      "body": "Release plan\n1. Build\n2. Verify\ncargo test",
      "formattedBody": "<h2>Release <strong>plan</strong></h2><ol start=\"1\"><li>Build</li><li>Verify</li></ol><p><code>cargo test</code></p>",
      "expect": {
        "accepted": true,
        "textContains": ["Release", "plan", "Build", "Verify", "cargo test"],
        "textExcludes": [],
        "linkSchemes": [],
        "containsSpoiler": false,
        "forbiddenFragments": ["onclick=", "javascript:", "<script"],
        "semanticKinds": ["heading", "bold", "orderedList", "inlineCode"],
        "inlineCode": ["cargo test"],
        "orderedListStarts": [1]
      },
      "notCompared": ["typography", "listMarkers", "prismTokens", "dynamicType"]
    },
    {
      "id": "golden-hermes-approval",
      "class": "golden",
      "body": "Dangerous command requires approval. Reply !approve, !approve session, !approve always, or !deny.",
      "formattedBody": "<p>⚠️ <strong>Dangerous command requires approval</strong></p><pre><code class=\"language-shell\">rm -rf /tmp/example\n</code></pre><p>Reply <code>!approve</code>, <code>!approve session</code>, <code>!approve always</code>, or <code>!deny</code>.</p>",
      "expect": {
        "accepted": true,
        "textContains": [
          "Dangerous command requires approval",
          "rm -rf /tmp/example",
          "!approve session",
          "!approve always",
          "!deny"
        ],
        "textExcludes": [],
        "linkSchemes": [],
        "containsSpoiler": false,
        "forbiddenFragments": ["onclick=", "javascript:", "<script"],
        "semanticKinds": ["bold", "inlineCode", "preformattedCode"],
        "inlineCode": [
          "!approve",
          "!approve session",
          "!approve always",
          "!deny"
        ],
        "codeBlocks": ["rm -rf /tmp/example\n"]
      },
      "notCompared": ["approvalCardChrome", "syntaxHighlighting", "typography"]
    },
    {
      "id": "golden-mentions-and-links",
