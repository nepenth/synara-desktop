{
  "schemaVersion": 1,
  "outboundTextPayloadMaxBytes": 65536,
  "presentationFormattedBodyMaxBytes": 262144,
  "cases": [
    {
      "id": "golden-rich-structure",
      "class": "golden",
      "body": "Release plan\n1. Build\n2. Verify\ncargo test",
      "formattedBody": "<h2>Release <strong>plan</strong></h2><ol start=\"1\"><li>Build</li><li>Verify</li></ol><p><code>cargo test</code></p>",
      "expect": {
        "accepted": true,
        "textContains": ["Release", "plan", "Build", "Verify", "cargo test"],
        "textExcludes": [],
        "linkSchemes": [],
        "containsSpoiler": false,
        "forbiddenFragments": ["onclick=", "javascript:", "<script"]
      },
      "notCompared": ["typography", "listMarkers", "prismTokens", "dynamicType"]
    },
    {
      "id": "golden-hermes-approval",
      "class": "golden",
      "body": "Dangerous command requires approval. Reply !approve, !approve session, !approve always, or !deny.",
      "formattedBody": "<p>⚠️ <strong>Dangerous command requires approval</strong></p><pre><code class=\"language-shell\">rm -rf /tmp/example\n</code></pre><p>Reply <code>!approve</code>, <code>!approve session</code>, <code>!approve always</code>, or <code>!deny</code>.</p>",
      "expect": {
        "accepted": true,
        "textContains": ["Dangerous command requires approval", "rm -rf /tmp/example", "!approve session", "!approve always", "!deny"],
        "textExcludes": [],
        "linkSchemes": [],
        "containsSpoiler": false,
        "forbiddenFragments": ["onclick=", "javascript:", "<script"]
      },
      "notCompared": ["approvalCardChrome", "syntaxHighlighting", "typography"]
    },
    {
