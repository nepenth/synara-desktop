      "expect": {
        "accepted": true,
        "textContains": ["Alice", "docs", "mail", "mirror", "magnet"],
        "textExcludes": [],
        "linkSchemes": ["https", "http", "mailto", "ftp", "magnet"],
        "containsSpoiler": false,
        "forbiddenFragments": ["javascript:", "data:text/html"],
        "mentionTargets": ["https://matrix.to/#/@alice:example.org"]
      },
      "notCompared": ["linkColor", "target", "rel"]
    },
