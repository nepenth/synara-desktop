// P4-1: deliberately narrow FFI bootstrap. Product commands and platform
// callbacks are added only as their P4 migration slices land. Keeping this
// namespace generated from a project-owned UDL proves the binding pipeline
// without exposing credentials, Matrix SDK types, or shell-owned services.
namespace synara_core {
  string binding_scaffold_version();

  // P4-2: credential-free, read-only Matrix login-flow discovery. The
  // homeserver URL is normalized by the shared core before its bounded,
  // redirect-free request is assembled.
  [Async, Throws=LoginFlowsError]
  sequence<LoginFlowDto> login_flows(string homeserver_url);

  // P4-S1: credential-free registration-flow discovery. The closed DTO omits
  // the desktop-only raw JSON params field from the UniFFI boundary.
  [Async, Throws=RegisterFlowsError]
  RegisterFlowsDto register_flows(string homeserver_url);

  // P4: pure per-row unread/highlight projection used by the live iOS
  // room-list adapter. This has no state, callback, error, or string input.
  RoomUnreadPresentationDto room_unread_presentation(
    RoomUnreadMembership membership,
    u64 num_unread_messages,
    u64 num_unread_notifications,
    u64 num_unread_mentions,
    boolean is_marked_unread
  );

  // P4: total cold-start recovery gate. It accepts only a scalar latest-state
  // bit and a closed previous-state enum, and has no error or callback path.
  boolean room_activity_recovery_required(
    boolean latest_requires_recovery,
    RoomActivityPreviousState previous_state
  );
};

// Closed scalar input for the per-row unread presentation. It intentionally
// does not carry a Matrix identifier, SDK value, or diagnostic string.
enum RoomUnreadMembership {
  "Joined",
  "Invited"
};

// Scalar output of the total per-row unread presentation. The full-width
// counter and boolean are the entire cross-platform surface.
dictionary RoomUnreadPresentationDto {
  u64 unread_count;
  boolean has_highlight;
};

// Closed prior-activity classification for the cold-start recovery gate.
// It never carries an identifier, SDK value, or diagnostic.
enum RoomActivityPreviousState {
  "Missing",
  "Known"
};

// Public Swift DTO for one homeserver-advertised Matrix login type. It never
// carries a credential, session, or client handle.
dictionary LoginFlowDto {
  string kind;
  string matrix_type;
  boolean? get_login_token;
};

// All fields below are fixed, privacy-safe values. In particular, no input
// URL, HTTP diagnostic, response body, header, credential, or token crosses
// the UniFFI error boundary.
[Error]
interface LoginFlowsError {
  ProbeFailed(string category, string code, string description);
};

// One UIAA registration flow. Stages are public Matrix identifiers; raw UIAA
// params and response JSON never cross the UniFFI boundary.
dictionary RegisterUiaFlowDto {
  sequence<string> stages;
};

enum RegisterFlowsStatus {
  "FlowRequired",
  "RegistrationDisabled",
  "RateLimited",
  "InvalidRequest"
};

dictionary RegisterFlowsDto {
  RegisterFlowsStatus status;
  string? session;
  sequence<RegisterUiaFlowDto> flows;
  sequence<string> completed;
};

// All fields are fixed, privacy-safe values. No URL, token, HTTP body, raw
// response detail, or caller input crosses the UniFFI error boundary.
[Error]
interface RegisterFlowsError {
  ProbeFailed(string category, string code, string description);
};

// P4-3: the iOS shell may mirror only the safe state of an already-installed
// MatrixRustSDK client. This is not a client/session/credential API: it is a
// Core open/close/session_snapshot facade with exactly six crossed fields.
dictionary SessionProjection {
  u64 generation;
  string user_id;
  string device_id;
  string homeserver_url;
  SessionProjectionLifecycle lifecycle;
  boolean crypto_ready;
};

// Closed values only; no shell or SDK diagnostic string can be a lifecycle.
enum SessionProjectionLifecycle {
  "Empty",
  "Opening",
  "Authenticating",
  "Restoring",
  "Syncing",
  "Ready",
  "Stopping",
  "LoggedOut",
  "Failed",
  "Wiping"
};

// All error fields below are fixed, privacy-safe source constants. Invalid
// identifiers/URLs and Core internals are intentionally not echoed.
[Error]
interface SessionProjectionError {
  Rejected(string code, string description);
  Unavailable(string code, string description);
};

// The project-owned object does not expose Core, Platform, commands,
// callbacks, Matrix SDK values, persistence, or networking.
interface SessionProjectionCore {
  constructor();

  [Async, Throws=SessionProjectionError]
  void open(SessionProjection projection);

  [Async, Throws=SessionProjectionError]
  SessionProjection? session_snapshot();

  [Async, Throws=SessionProjectionError]
  void close();
};

// P4-S3a: Swift-owned key/value secret store. Session tokens may live here
// later. Passwords, recovery secrets, and media bytes must not use this as a
// generic Core.command channel. Errors are static; keys/values are not echoed.
[Error]
interface IosSecretVaultError {
  Unavailable(string code, string description);
};

callback interface IosSecretVault {
  [Throws=IosSecretVaultError]
  bytes? get(string key);

  [Throws=IosSecretVaultError]
  void put(string key, bytes value);

  [Throws=IosSecretVaultError]
  void delete(string key);
};

// Privacy-safe restore outcome. Tokens never cross this DTO.
dictionary SessionRestoreDto {
  string user_id;
  string device_id;
  string homeserver_url;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface SessionRestoreError {
  Failed(string code, string description);
};

// Privacy-safe login outcome. Tokens and password never cross this DTO.
dictionary SessionLoginDto {
  string user_id;
  string device_id;
  string homeserver_url;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface SessionLoginError {
  Failed(string code, string description);
};

// Privacy-safe attach outcome. Owner names only. No tokens or password.
dictionary SessionAttachDto {
  sequence<string> owners;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface SessionAttachError {
  Failed(string code, string description);
};

// Privacy-safe room-list row. No tokens or password.
dictionary RoomListRoomDto {
  string room_id;
  string? name;
  string? canonical_alias;
  string? avatar_url;
  string membership;
  boolean is_direct;
  boolean is_space;
  boolean is_favorite;
  u32 unread_count;
  u32 highlight_count;
  boolean marked_unread;
  u64? last_activity_ts;
};

// Privacy-safe room-list snapshot from the registered Core command.
dictionary RoomListSnapshotDto {
  u64 session_generation;
  sequence<string> ordered_room_ids;
  sequence<RoomListRoomDto> rooms;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface RoomListSnapshotError {
  Failed(string code, string description);
};

// Privacy-safe invite row. No tokens or password.
dictionary InviteDto {
  string room_id;
  string room_name;
  string? avatar_handle_id;
  string? room_topic;
  string? room_alias;
  string sender_id;
  string sender_name;
  boolean sender_ignored;
  u64? invite_ts;
  string? reason;
  boolean is_space;
  boolean is_direct;
  boolean is_encrypted;
  string triage;
};

// Privacy-safe invite snapshot from the registered Core command.
dictionary InviteSnapshotDto {
  u64 session_generation;
  sequence<InviteDto> invites;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface InviteSnapshotError {
  Failed(string code, string description);
};

// Requested open placement. Closed kind strings only. No tokens or password.
dictionary TimelineOpenPositionDto {
  string kind;
  boolean at_bottom;
  string? restored_anchor_event_id;
  string? live_tail_event_id;
  u64? updated_at_ms;
  string? event_id;
};

// Privacy-safe resolved view placement. No tokens or password.
dictionary TimelineViewPositionDto {
  string kind;
  string? event_id;
};

// Privacy-safe timeline snapshot from the registered Core command.
dictionary TimelineSnapshotDto {
  u32 schema_version;
  u64 session_generation;
  string room_id;
  u64 revision;
  TimelineViewPositionDto position;
  string pagination_backward;
  string pagination_forward;
  string? own_read_event_id;
  string? unread_anchor_event_id;
  boolean is_marked_unread;
  sequence<string> pinned_event_ids;
  u32 row_count;
  boolean mark_read;
  boolean mark_unread;
  boolean paginate_backward;
  boolean paginate_forward;
};

// Privacy-safe timeline open readback. No tokens or password.
dictionary TimelineOpenDto {
  u32 schema_version;
  string stream_id;
  TimelineViewPositionDto position;
  TimelineSnapshotDto snapshot;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface TimelineError {
  Failed(string code, string description);
};

// Privacy-safe typing room row. No tokens or password.
dictionary TypingRoomDto {
  string room_id;
  sequence<string> user_ids;
};

// Privacy-safe typing snapshot from the registered Core command.
dictionary TypingSnapshotDto {
  u64 session_generation;
  sequence<TypingRoomDto> rooms;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface TypingCommandError {
  Failed(string code, string description);
};

// Privacy-safe presence snapshot. Identity fields only; no tokens or password.
dictionary PresenceSnapshotDto {
  string status;
  u64 session_generation;
  string user_id;
  string? state;
  boolean currently_active;
  u64? last_active_ts;
  string? status_msg;
};

// Privacy-safe presence subscription. No tokens or password.
dictionary PresenceSubscriptionDto {
  string subscription_id;
  string user_id;
  u64 session_generation;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface PresenceCommandError {
  Failed(string code, string description);
};

// Privacy-safe SAS emoji. User-visible comparison only; no key material.
dictionary VerificationEmojiDto {
  string symbol;
  string description;
};

// Privacy-safe SAS comparison. Emoji/decimals only; no tokens or MACs.
dictionary VerificationSasDto {
  sequence<VerificationEmojiDto>? emoji;
  sequence<u16>? decimals;
};

// Privacy-safe verification request row. Identity/flow fields only; no tokens.
// S8 list omits SAS. S9 mutation returns may include optional SAS comparison.
dictionary VerificationRequestDto {
  string flow_id;
  string other_user_id;
  string? other_device_id;
  string direction;
  string phase;
  u64? started_ts;
  VerificationSasDto? sas;
};

// Privacy-safe verification inbox from the registered Core command.
dictionary VerificationInboxDto {
  u64 session_generation;
  sequence<VerificationRequestDto> requests;
};

// Static source constants only. Never echo user id, URL, path, token, or password.
[Error]
interface VerificationListError {
  Failed(string code, string description);
};

// Static source constants only. Never echo user id, device id, flow id, token, or password.
[Error]
interface VerificationSasError {
  Failed(string code, string description);
};

// P4-S2 constructor stays fail-closed. P4-S3a adds a vault-backed constructor.
// P4-S3b adds restore_persisted_session. P4-S3c adds dedicated login_with_password.
// P4-S3d adds attach_session_owners for the desktop owner set.
// P4-S4 adds typed room_list_snapshot for matrix_room_list_snapshot only.
// P4-S5 adds typed invites_snapshot for matrix_invites_snapshot only.
// P4-S6 adds typed timeline_open / timeline_close / timeline_paginate only.
// P4-S7 adds typed typing_snapshot / typing_set / presence_snapshot /
// presence_subscribe / presence_unsubscribe only.
// P4-S8 adds typed verification_list for the registered list command only.
// P4-S9 adds typed verification SAS start/accept/begin_sas/confirm/mismatch/cancel/dismiss.
// Password is a method argument only: not stored, not in the DTO, never echoed.
// Still no generic command FFI, leftover registration, or APNs surface.
interface SharedCore {
  constructor();
  [Name="new_with_secret_store"]
  constructor(IosSecretVault store);

  [Async, Throws=SessionRestoreError]
  SessionRestoreDto restore_persisted_session(
    string user_id,
    string homeserver_url,
    string store_root
  );

  [Async, Throws=SessionLoginError]
  SessionLoginDto login_with_password(
    string user_id,
    string homeserver_url,
    string store_root,
    string password
  );

  [Async, Throws=SessionAttachError]
  SessionAttachDto attach_session_owners();

  [Async, Throws=RoomListSnapshotError]
  RoomListSnapshotDto room_list_snapshot();

  [Async, Throws=InviteSnapshotError]
  InviteSnapshotDto invites_snapshot();

  [Async, Throws=TimelineError]
  TimelineOpenDto timeline_open(string room_id, TimelineOpenPositionDto position);

  [Async, Throws=TimelineError]
  boolean timeline_close(string stream_id);

  [Async, Throws=TimelineError]
  TimelineSnapshotDto timeline_paginate(string stream_id, string direction);

  [Async, Throws=TypingCommandError]
  TypingSnapshotDto typing_snapshot();

  [Async, Throws=TypingCommandError]
  void typing_set(string room_id, boolean typing);

  [Async, Throws=PresenceCommandError]
  PresenceSnapshotDto presence_snapshot(string user_id);

  [Async, Throws=PresenceCommandError]
  PresenceSubscriptionDto presence_subscribe(string user_id);

  [Async, Throws=PresenceCommandError]
  void presence_unsubscribe(string subscription_id);

  [Async, Throws=VerificationListError]
  VerificationInboxDto verification_list();

  [Async, Throws=VerificationSasError]
  VerificationRequestDto verification_start(string? device_id);

  [Async, Throws=VerificationSasError]
  VerificationRequestDto verification_accept(string flow_id);

  [Async, Throws=VerificationSasError]
  VerificationRequestDto verification_begin_sas(string flow_id);

  [Async, Throws=VerificationSasError]
  VerificationRequestDto verification_confirm(string flow_id);

  [Async, Throws=VerificationSasError]
  VerificationRequestDto verification_mismatch(string flow_id);

  [Async, Throws=VerificationSasError]
  VerificationRequestDto verification_cancel(string flow_id);

  [Async, Throws=VerificationSasError]
  void verification_dismiss(string flow_id);
};
