# Maintainer: Synara contributors
pkgname=synara-desktop-bin
_repo_root="$(cd "${startdir}/../.." && pwd)"
_tauri_conf="${_repo_root}/src-tauri/tauri.conf.json"
_tauri_version="$(sed -nE 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' "${_tauri_conf}" | head -n 1)"
if [[ -z "${_tauri_version}" ]]; then
  printf 'Unable to read Synara version from %s\n' "${_tauri_conf}" >&2
  return 1 2>/dev/null || exit 1
fi
pkgver="${_tauri_version//-/_}"
pkgrel=1
pkgdesc='High-performance Matrix client optimized for AI agent workflows'
arch=('x86_64')
url='https://github.com/nepenth/synara-desktop'
license=('AGPL-3.0-only')
depends=(
  'dbus'
  'enchant'
  'gtk3'
  'hunspell-en_us'
  'libsecret'
  'webkit2gtk-4.1'
  'xdg-desktop-portal'
  'gst-plugins-good'
  'libayatana-appindicator'
  'librsvg'
  'openssl'
)
optdepends=(
  'kwallet: KDE Wallet backend for Secret Service-compatible session storage'
  'gnome-keyring: GNOME Secret Service provider for session storage'
  'xdg-desktop-portal-kde: KDE Plasma Wayland file and media portal support'
  'xdg-utils: open external links with the desktop default browser'
)
provides=('synara-desktop' 'synara')
conflicts=('synara-desktop' 'synara')
source=('synara' 'synara.desktop')
sha256sums=('SKIP' 'SKIP')

package() {
  local desktop_file="${startdir}/synara.desktop"
  local release_binary="${_repo_root}/src-tauri/target/release/synara"

  if [[ ! -f "${release_binary}" ]]; then
    printf 'Synara release binary was not found. Run `npm run tauri build` from the repository root before `makepkg -f`.\n' >&2
    return 1
  fi
  if [[ ! -f "${desktop_file}" ]]; then
    printf 'Synara desktop entry was not found at %s.\n' "${desktop_file}" >&2
    return 1
  fi

  install -Dm755 "${release_binary}" "${pkgdir}/usr/lib/synara/synara"
  install -Dm755 "${srcdir}/synara" "${pkgdir}/usr/bin/synara"
  install -Dm644 "${desktop_file}" "${pkgdir}/usr/share/applications/Synara.desktop"
  install -Dm644 "${_repo_root}/src-tauri/icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/synara.png"
  install -Dm644 "${_repo_root}/src-tauri/icons/48x48.png" "${pkgdir}/usr/share/icons/hicolor/48x48/apps/synara.png"
  install -Dm644 "${_repo_root}/src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/synara.png"
  install -Dm644 "${_repo_root}/src-tauri/icons/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/synara.png"
  install -Dm644 "${_repo_root}/assets/branding/synara-symbolic.svg" "${pkgdir}/usr/share/icons/hicolor/symbolic/apps/synara-symbolic.svg"
  install -Dm644 "${_repo_root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
