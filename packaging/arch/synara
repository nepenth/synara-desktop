#!/bin/sh

# Keep the app on native Wayland, and make this package's default drawing mode
# "balanced": the graphics card composites, but frames are not presented as
# DMABUF buffers, the path behind most NVIDIA blank-window and crash reports.
# If the web view still crashes, or a start ends before the window has drawn,
# the binary switches itself to "safe" (CPU drawing) until the user picks a
# mode again. The binary applies all of this at startup. What decides, first
# match wins:
#   SYNARA_RENDERING=safe|balanced|gpu   for this start; passes through here untouched
#   the "Hardware acceleration" setting, once the user has chosen
#   SYNARA_RENDERING_DEFAULT    this package's default, set below
# A WEBKIT_DISABLE_* or __NV_DISABLE_EXPLICIT_SYNC variable already set in the
# environment is left alone. See docs/linux.md.
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
  export GDK_BACKEND="${GDK_BACKEND:-wayland}"
  export SYNARA_RENDERING_DEFAULT="${SYNARA_RENDERING_DEFAULT:-balanced}"
fi

exec /usr/lib/synara/synara "$@"
