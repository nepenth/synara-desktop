{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synara.local/contracts/synara-agent-approval-history-content.schema.json",
  "$comment": "Canonical writer schema for in.synara.agent_approval_history v1. Live Core readers fail closed on missing or unsupported versions and on a non-array items value. Malformed items inside a recognized v1 array may be dropped. Summary is at most 240 Unicode scalars and must never be the full command body. Core writers redact path-like args to <path> and secret-like assignments/flags to <redacted>. Core also rejects expiresAt <= originServerTs (not expressible as a JSON Schema comparison), encoded payloads over 256 KiB, and prunes items older than 30 days / beyond 200 newest (roomId, eventId) rows. additionalProperties is false, matching Later/room-notes writer schemas.",
  "title": "SynaraAgentApprovalHistoryContent",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/SynaraAgentApprovalHistoryItem"
      }
    }
  },
  "$defs": {
    "SynaraAgentApprovalHistoryItem": {
      "title": "SynaraAgentApprovalHistoryItem",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roomId",
        "eventId",
        "sender",
        "decision",
        "decidedAt",
        "originServerTs",
        "expiresAt",
        "summary"
      ],
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255,
          "pattern": "^![^\\s:]+:[^\\s]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 255,
          "pattern": "^\\$[^\\s]+$"
        },
        "sender": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256,
          "pattern": "^@[^\\s:]+:[^\\s]+$"
        },
        "decision": {
          "type": "string",
          "enum": ["approve_once", "approve_always", "deny"]
        },
        "decidedAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "originServerTs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expiresAt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "summary": {
          "type": "string",
          "maxLength": 240
        }
      }
    }
  }
}
