{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synara.local/contracts/synara-room-event-anchor.schema.json",
  "$comment": "Canonical opaque Matrix room/event/thread anchor payload. Display text and message previews are intentionally excluded.",
  "title": "SynaraRoomEventAnchor",
  "type": "object",
  "additionalProperties": false,
  "required": ["roomIdOrAlias"],
  "properties": {
    "roomIdOrAlias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[!#][^\\s]+(:[^\\s]+)?$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\$[^\\s]+$"
    },
    "threadRootEventId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\$[^\\s]+$"
    },
    "parentSpaceIdOrAlias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[!#][^\\s]+(:[^\\s]+)?$"
    }
  }
}
