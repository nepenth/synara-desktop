{
  "compilerOptions": {
    "sourceMap": true,
    "jsx": "react",
    "target": "ES2022",
    "module": "ESNext",
    "allowJs": false,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
