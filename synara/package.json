{
  "name": "synara",
  "version": "2.1.42",
  "description": "Synara app runtime for the native desktop shell",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "lint": "npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"e2e/**/*.{js,mjs,ts}\" playwright.config.ts",
    "check:prettier": "prettier --check .",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "test:modernization": "node scripts/run-modernization-tests.mjs",
    "test:browser:timeline": "playwright test e2e/timeline-scroll.spec.ts --project=chromium",
    "test:timeline-performance": "node scripts/run-timeline-performance-harness.mjs",
    "typecheck:modernization": "tsc --noEmit -p tsconfig.modernization.json",
    "fix:prettier": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test:browser:native-timeline": "playwright test --config e2e/native-timeline-harness/playwright.config.ts",
    "test:browser:desktop-polish:ci": "playwright test --config e2e/room-list-harness/playwright.config.ts --project=chromium && playwright test --config e2e/approvals-harness/playwright.config.ts --project=chromium",
    "test:browser:desktop-polish": "playwright test --config e2e/room-list-harness/playwright.config.ts && playwright test --config e2e/approvals-harness/playwright.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint",
    "*": "prettier --ignore-unknown --write"
  },
  "keywords": [],
  "author": "Synara contributors",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
