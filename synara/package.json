{
  "name": "synara",
  "version": "1.2.31",
  "description": "Synara app runtime for the native desktop shell",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "lint": "npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "check:prettier": "prettier --check .",
    "test:modernization": "node scripts/run-modernization-tests.mjs",
    "test:timeline-performance": "node scripts/run-timeline-performance-harness.mjs",
    "typecheck:modernization": "tsc --noEmit -p tsconfig.modernization.json",
    "fix:prettier": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "semantic-release": "npx --yes semantic-release@25.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint",
    "*": "prettier --ignore-unknown --write"
  },
  "release": {
    "branches": [
      "dev"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node scripts/update-version.js ${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json",
            "src/app/features/settings/about/About.tsx",
            "src/app/pages/auth/AuthFooter.tsx",
            "src/app/pages/client/WelcomePage.tsx"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "keywords": [],
  "author": "Synara contributors",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "1.1.6",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "1.3.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "1.0.3",
    "@fontsource/inter": "4.5.14",
    "@tanstack/react-query": "5.24.1",
    "@tanstack/react-query-devtools": "5.24.1",
    "@tanstack/react-virtual": "3.2.0",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@vanilla-extract/css": "1.20.1",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.2.2",
    "await-to-js": "3.0.0",
    "badwords-list": "2.0.1-4",
    "blurhash": "2.0.4",
    "browser-encrypt-attachment": "0.3.0",
    "chroma-js": "3.1.2",
    "classnames": "2.3.2",
    "dateformat": "5.0.3",
    "dayjs": "1.11.10",
    "domhandler": "5.0.3",
    "emojibase": "15.3.1",
    "emojibase-data": "15.3.2",
    "file-saver": "2.0.5",
    "focus-trap-react": "10.0.2",
    "folds": "2.6.2",
    "html-dom-parser": "4.0.0",
    "html-react-parser": "4.2.0",
    "i18next": "23.12.2",
    "i18next-browser-languagedetector": "8.0.0",
    "i18next-http-backend": "4.0.0",
    "immer": "9.0.16",
    "is-hotkey": "0.2.0",
    "jotai": "2.6.0",
    "linkify-react": "4.3.2",
    "linkifyjs": "4.3.2",
    "matrix-js-sdk": "38.2.0",
    "matrix-widget-api": "1.13.0",
    "millify": "6.1.0",
    "pdfjs-dist": "5.7.284",
    "prismjs": "1.30.0",
    "react": "19.2.6",
    "react-aria": "3.29.1",
    "react-blurhash": "0.2.0",
    "react-colorful": "5.6.1",
    "react-dom": "19.2.6",
    "react-error-boundary": "4.0.13",
    "react-google-recaptcha": "2.1.0",
    "react-i18next": "15.0.0",
    "react-range": "1.8.14",
    "react-router-dom": "6.30.3",
    "sanitize-html": "2.17.4",
    "slate": "0.123.0",
    "slate-dom": "0.123.0",
    "slate-history": "0.113.1",
    "slate-react": "0.123.0",
    "ua-parser-js": "1.0.35"
  },
  "devDependencies": {
    "@element-hq/element-call-embedded": "0.16.3",
    "@esbuild-plugins/node-globals-polyfill": "0.2.3",
    "@eslint/js": "9.39.4",
    "@rollup/plugin-inject": "5.0.3",
    "@rollup/plugin-wasm": "6.1.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@types/chroma-js": "3.1.1",
    "@types/file-saver": "2.0.5",
    "@types/is-hotkey": "0.1.10",
    "@types/node": "18.11.18",
    "@types/prismjs": "1.26.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-google-recaptcha": "2.1.8",
    "@types/sanitize-html": "2.9.0",
    "@types/ua-parser-js": "0.7.36",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitejs/plugin-react": "5.2.0",
    "buffer": "6.0.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.3.2",
    "prettier": "2.8.1",
    "typescript": "5.7.3",
    "vite": "7.3.3",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-static-copy": "3.4.0",
    "vite-plugin-top-level-await": "1.4.4"
  },
  "overrides": {
    "workbox-build": {
      "glob": "13.0.6"
    }
  }
}
