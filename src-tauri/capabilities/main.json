{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Synara desktop runtime permissions for the main webview. Global shortcuts are validated in Rust before registration; external URLs are filtered in desktop.rs and the Synara desktop URL policy.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*/*"]
  },
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:allow-permission-state",
    "notification:allow-request-permission",
    "notification:allow-show",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister-all",
    "opener:allow-open-url",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "window-state:default",
    "allow-desktop-show",
    "allow-desktop-hide",
    "allow-desktop-navigate",
    "allow-desktop-set-badge-count",
    "allow-desktop-set-shortcuts",
    "allow-desktop-secret-store-status",
    "allow-desktop-get-session",
    "allow-desktop-set-session",
    "allow-desktop-remove-session",
    "allow-desktop-get-integration-status",
    "allow-desktop-update-tray-state",
    "allow-desktop-get-notification-permission",
    "allow-desktop-request-notification-permission",
    "allow-desktop-notify",
    "allow-desktop-open-external-url",
    "allow-desktop-save-file",
    "allow-desktop-save-file-begin",
    "allow-desktop-save-file-chunk",
    "allow-desktop-save-file-end",
    "allow-desktop-save-file-abort",
    "allow-desktop-read-dropped-files",
    "allow-desktop-read-dropped-file-chunk",
    "allow-desktop-read-dropped-file-end",
    "allow-desktop-get-performance-capabilities",
    "allow-desktop-append-log",
    "allow-desktop-log-path",
    "allow-desktop-agent-action"
  ]
}
