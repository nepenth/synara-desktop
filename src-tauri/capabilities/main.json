{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Synara desktop runtime permissions for the main webview. Global shortcuts are validated in Rust before registration; external URLs are filtered in desktop.rs and the Synara desktop URL policy.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*/*"]
  },
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:allow-permission-state",
    "notification:allow-request-permission",
    "notification:allow-show",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister-all",
    "opener:allow-open-url",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "window-state:default",
    "allow-desktop-show",
    "allow-desktop-hide",
    "allow-desktop-navigate",
    "allow-desktop-set-badge-count",
    "allow-desktop-set-shortcuts",
    "allow-desktop-secret-store-status",
    "allow-desktop-get-session",
    "allow-desktop-set-session",
    "allow-desktop-remove-session",
    "allow-desktop-get-integration-status",
    "allow-desktop-update-tray-state",
    "allow-desktop-get-notification-permission",
    "allow-desktop-request-notification-permission",
    "allow-desktop-notify",
    "allow-desktop-open-external-url",
    "allow-desktop-save-file",
    "allow-desktop-save-file-begin",
    "allow-desktop-save-file-chunk",
    "allow-desktop-save-file-end",
    "allow-desktop-save-file-abort",
    "allow-desktop-read-dropped-files",
    "allow-desktop-read-dropped-file-chunk",
    "allow-desktop-read-dropped-file-end",
    "allow-desktop-get-performance-capabilities",
    "allow-matrix-verification-list",
    "allow-matrix-verification-start",
    "allow-matrix-verification-accept",
    "allow-matrix-verification-begin-sas",
    "allow-matrix-verification-confirm",
    "allow-matrix-verification-mismatch",
    "allow-matrix-verification-cancel",
    "allow-matrix-verification-dismiss",
    "allow-matrix-device-snapshot",
    "allow-matrix-device-rename",
    "allow-matrix-device-delete-start",
    "allow-matrix-device-delete-password",
    "allow-matrix-device-delete-cancel",
    "allow-desktop-append-log",
    "allow-desktop-log-path",
    "allow-desktop-record-diagnostic",
    "allow-desktop-diagnostics-status",
    "allow-desktop-read-diagnostics",
    "allow-desktop-clear-diagnostics",
    "allow-desktop-enable-spellcheck",
    "allow-desktop-agent-action",
    "allow-matrix-login-password",
    "allow-matrix-session-snapshot",
    "allow-matrix-sync-status",
    "allow-matrix-crypto-status",
    "allow-matrix-cross-signing-status",
    "allow-matrix-cross-signing-setup",
    "allow-matrix-cross-signing-setup-password",
    "allow-matrix-backup-status",
    "allow-matrix-backup-setup",
    "allow-matrix-backup-restore",
    "allow-matrix-backup-repair",
    "allow-matrix-secret-storage-status",
    "allow-matrix-secret-storage-bootstrap",
    "allow-matrix-secret-storage-unlock",
    "allow-matrix-secret-storage-reset",
    "allow-matrix-room-key-transfer-status",
    "allow-matrix-room-key-export",
    "allow-matrix-room-key-import-select",
    "allow-matrix-room-key-import",
    "allow-matrix-room-list-snapshot",
    "allow-matrix-invites-snapshot",
    "allow-matrix-invites-accept",
    "allow-matrix-invites-decline",
    "allow-matrix-invites-report-spam",
    "allow-matrix-invites-block-sender",
    "allow-matrix-typing-snapshot",
    "allow-matrix-typing-set",
    "allow-matrix-space-parents-snapshot",
    "allow-matrix-mdirect-snapshot",
    "allow-matrix-timeline-open",
    "allow-matrix-timeline-snapshot",
    "allow-matrix-timeline-paginate",
    "allow-matrix-timeline-reaction-toggle",
    "allow-matrix-reaction-ensure",
    "allow-matrix-reaction-redact",
    "allow-matrix-send-text",
    "allow-matrix-send-attachment",
    "allow-matrix-logout",
    "allow-matrix-restore-session"
  ]
}
