{
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "bannerPath": "wix/banner.bmp",
        "dialogImagePath": "wix/dialogImage.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "SocialNetworking",
    "shortDescription": "A modern Matrix client",
    "longDescription": "",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeBuildCommand": "cd cinny && npm run build",
    "frontendDist": "../cinny/dist",
    "beforeDevCommand": "cd cinny && npm start",
    "devUrl": "http://localhost:8080"
  },
  "productName": "Synara",
  "mainBinaryName": "synara",
  "version": "4.11.3-synara.3",
  "identifier": "app.synara.desktop",
  "app": {
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: filesystem: http: https:; font-src 'self' data:; media-src 'self' data: blob: http: https:; connect-src 'self' blob: ipc: ws: wss: http: https: http://ipc.localhost; worker-src 'self' blob:; frame-src http: https:; form-action 'none'"
    }
  }
}
