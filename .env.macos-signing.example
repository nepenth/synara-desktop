# Copy this file to .env.macos-signing.local and fill in local-only values.
# .env.macos-signing.local is gitignored.

APPLE_TEAM_ID=NK6CM9YJC6
APPLE_SIGNING_IDENTITY="Developer ID Application: Whyland Creative LLC (NK6CM9YJC6)"

# App-specific password notarization path.
APPLE_ID=apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional App Store Connect API key notarization path.
# Use this instead of APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD if preferred.
# APPLE_API_KEY=ABC123DEFG
# APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
# APPLE_API_KEY_PATH=/absolute/path/AuthKey_ABC123DEFG.p8

# Defaults shown here can be omitted.
SYNARA_MACOS_TARGET=universal-apple-darwin
SYNARA_MACOS_BUNDLES=dmg
