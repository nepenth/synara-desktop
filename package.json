{
  "name": "synara-desktop",
  "version": "1.2.59",
  "description": "Synara Desktop, a high-performance Matrix client for secure conversations and agent workflows.",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:macos:local": "scripts/build-macos-local-release.sh",
    "build:pacman-repo": "scripts/build-pacman-repo.sh",
    "audit:matrix-public": "node scripts/audit-matrix-public.mjs",
    "check:matrix-boundaries": "node scripts/check-matrix-boundaries.mjs",
    "inventory:matrix-sdk-usage": "node scripts/inventory-matrix-sdk-usage.mjs --write",
    "check:matrix-sdk-usage": "node scripts/inventory-matrix-sdk-usage.mjs --check",
    "check:quality-gates": "node scripts/check-quality-gates.mjs && node scripts/check-workflow-policy.mjs",
    "check:synapse-harness": "node scripts/check-synapse-integration-harness.mjs",
    "test:synapse-integration": "SYNARA_RUN_SYNAPSE_INTEGRATION=1 npm --prefix synara exec -- vite-node --config synara/scripts/vite-node.integration.config.mjs synara/scripts/run-synapse-two-client-integration.mjs",
    "check:mip1-evidence": "node scripts/check-mip1-commit-evidence.mjs --base main",
    "check:production-smoke": "node scripts/check-production-smoke-checklist.mjs",
    "check:release-updater": "node scripts/check-release-updater.mjs",
    "check:repo-layout": "node scripts/check-repository-layout.mjs",
    "check:runtime-assets": "node scripts/check-runtime-assets.mjs",
    "bump:version": "node scripts/bump-version.mjs",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "pretauri": "node scripts/warn-macos-app-replace.mjs",
    "pretest:modernization": "node scripts/build-runtime.mjs",
    "tauri": "cp config.json synara/ && tauri",
    "test:modernization": "npm --prefix synara run test:modernization",
    "typecheck:modernization": "npm --prefix synara run typecheck:modernization"
  },
  "keywords": [
    "matrix",
    "chat",
    "ai-agents",
    "agentic",
    "desktop",
    "tauri"
  ],
  "author": "Synara contributors",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2"
  }
}
